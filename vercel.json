{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/api-status",
      "destination": "/api/index.js"
    },
    {
      "source": "/db-status",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|health|api-status|db-status).*)",
      "destination": "/public/$1"
    }
  ]
}
